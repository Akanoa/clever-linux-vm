# Fleet-wide settings for provision.sh.
#
#     ./new-fleet.sh              writes this file by asking, or
#     cp fleet.conf.example fleet.conf
#
# fleet.conf is gitignored because it carries your name and email; secrets
# live in .secrets/tokens.env (see ./agent-tokens.sh).
#
# Every value is a default - an environment variable of the same name takes
# precedence, so `FLAVOR=L ./provision.sh big-agent` still works.

# Commit identity used on every VM. GIT_USER_EMAIL must be an address
# verified on the forge, otherwise signatures show as unverified.
: "${GIT_USER_NAME:=Your Name}"
: "${GIT_USER_EMAIL:=you@example.com}"
: "${GIT_SIGN_COMMITS:=true}"

# How much a pane agent may do without a human approving each step:
#   default | acceptEdits | bypassPermissions
# Agents launched through `fleet start` have nobody at the keyboard, so
# anything stricter than acceptEdits will wedge them on the first command.
# bypassPermissions removes the gate entirely - note the VM holds your
# GitLab token and a commit key with push rights.
: "${CLAUDE_PERMISSION_MODE:=acceptEdits}"

# gitlab.com, or the host of a self-managed instance.
: "${GITLAB_HOST:=gitlab.com}"

# Cellar bucket for large files. Leave unset and it is derived from the
# add-on id - names are globally unique across Cellar, so a friendly one
# can collide with another tenant's.
# : "${CELLAR_BUCKET_NAME:=my-unique-bucket}"

# Size of VMs that do not exist yet: pico nano XS S M L XL 2XL 3XL. This
# is only a default - an existing VM keeps the size it has until you ask
# for a change with `--flavor`, so re-applying the fleet never resizes a
# box that was scaled up on purpose.
: "${FLAVOR:=M}"
: "${REGION:=par}"

# Organisation owning the applications and the add-ons. Unset means your
# personal space, which is what clever targets with no --org.
# : "${CLEVER_ORG:=orga_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}"

# The three shared add-ons are found by *name*, so these are what keep one
# fleet's storage and secrets separate from another's in the same
# organisation. Change them and provision.sh looks for - and creates - a
# different set: the old ones are not moved, they are abandoned, and they
# keep billing where nothing will look for them again. Delete a fleet's
# add-ons with `./provision.sh --destroy --all --purge --yes` before
# renaming, not after.
: "${FLEET_NAME:=vm-agent}"
: "${CONFIG_ADDON:=vm-agent-config}"
: "${CELLAR_ADDON:=vm-agent-cellar}"
: "${FS_ADDON:=vm-agent-fs}"

# Where the shared commit key lives. One key for the whole fleet unless
# provision.sh is given --per-vm-key.
# : "${KEY_PATH:=.secrets/id_ed25519}"

# Only read by ./new-fleet.sh, to offer your last answers as defaults.
: "${AGENT_BASE:=agent}"
: "${AGENT_COUNT:=2}"
