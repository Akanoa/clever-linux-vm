#!/usr/bin/env bash
# Copy agent state from local disk onto the FS Bucket.
#
# Runs every few minutes from the boot script, and can be called by hand
# before a `clever restart` to be sure the latest credentials and agent
# history are captured.
set -uo pipefail

# The FS Bucket is shared by the whole fleet; this VM only ever writes
# under its own subtree, so a --delete sync cannot reach another box.
PERSIST_ROOT="${PERSIST_ROOT:-${APP_HOME:-$HOME}/persistent}"
VM_ROOT="$PERSIST_ROOT/vms/${VM_AGENT_NAME:-default}"
LOCK="/tmp/vm-agent-snapshot.lock"

SYNC_DIRS=(
  "claude:$HOME/.claude"
  "codex:$HOME/.codex"
  "opencode-data:$HOME/.local/share/opencode"
  "opencode-config:$HOME/.config/opencode"
  "herdr:$HOME/.config/herdr"
  "gh:$HOME/.config/gh"
  "glab:$HOME/.config/glab-cli"
)
EXCLUDES=(--exclude='*.sock' --exclude='*.lock' --exclude='*.log' --exclude='.plugins.lock')
SYNC_FILES=(
  "claude.json:$HOME/.claude.json"
)

snapshot() {
  local name path dst
  for entry in "${SYNC_DIRS[@]}"; do
    name="${entry%%:*}"; path="${entry#*:}"; dst="$VM_ROOT/state/$name"
    [ -d "$path" ] || continue
    mkdir -p "$dst"
    rsync -a --delete "${EXCLUDES[@]}" "$path/" "$dst/" 2>/dev/null \
      || echo "vm-snapshot: failed to sync $name" >&2
  done
  local fname fpath
  mkdir -p "$VM_ROOT/state/files"
  for entry in "${SYNC_FILES[@]}"; do
    fname="${entry%%:*}"; fpath="${entry#*:}"
    [ -f "$fpath" ] || continue
    cp -a "$fpath" "$VM_ROOT/state/files/$fname" 2>/dev/null \
      || echo "vm-snapshot: failed to save $fname" >&2
  done
  date -u +'%Y-%m-%dT%H:%M:%SZ' > "$VM_ROOT/state/.last-snapshot" 2>/dev/null
}

# Never let two snapshots overlap; -n so the periodic loop skips rather
# than queues if the previous run is still going.
exec 9>"$LOCK"
if flock -n 9; then
  snapshot
  [ "${1:-}" = "--quiet" ] || echo "vm-snapshot: state saved to $VM_ROOT/state"
else
  [ "${1:-}" = "--quiet" ] || echo "vm-snapshot: another snapshot is running, skipped"
fi
