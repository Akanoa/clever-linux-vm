#!/usr/bin/env bash
# Talk to the other VMs in the fleet.
#
# herdr deliberately has no federation - `--remote` errors with "can only
# be specified once" - so this fills the gap over the one channel Clever
# Cloud actually routes between instances: each VM's own :8080 endpoint,
# published at https://app-<id>.cleverapps.io and protected by a shared
# token. Arbitrary ports are not reachable VM-to-VM, public or private.
#
#   fleet status                     one line per VM
#   fleet start <vm> <name> [kind]   launch an agent in a fresh pane
#   fleet agents                     every agent on every box
#   fleet read <vm>/<agent> [-f]     recent terminal output (-f to follow)
#   fleet attach <vm>[/<agent>]      attach the remote herdr UI (focus that agent)
#   fleet prompt <vm>/<agent> "..."  submit a prompt
#   fleet keys <vm>/<agent> esc      send key presses
#   fleet task <vm>/<agent> "..."    prompt, and collect the answer to a file
#   fleet fetch <vm>/<agent>         print that file
#   fleet out <vm>                   list a VM's result files
#   fleet get <vm> <path>            raw GET against one VM's endpoint
set -uo pipefail

# On a VM these come from the shared Configuration provider; locally,
# provision.sh drops them in .secrets/fleet.env. When both exist the file
# is the fresher one: a VM_AGENT_FLEET exported in some earlier shell
# outlives the fleet it described, and every VM in it then reports as
# unreachable rather than as gone. So the file wins, and we say so when
# the two actually disagree.
shell_fleet="${VM_AGENT_FLEET:-}"
for candidate in "$(dirname "${BASH_SOURCE[0]}")/../.secrets/fleet.env" \
                 "$PWD/.secrets/fleet.env"; do
  [ -f "$candidate" ] && . "$candidate" && break
done

FLEET="${VM_AGENT_FLEET:-}"
TOKEN="${VM_AGENT_FLEET_TOKEN:-}"
SELF="${VM_AGENT_NAME:-}"

c_ok=$'\033[32m'; c_dim=$'\033[2m'; c_err=$'\033[31m'; c_off=$'\033[0m'
die() { printf '%s%s%s\n' "$c_err" "fleet: $*" "$c_off" >&2; exit 1; }

# Before the roster checks: asking what this command does must work on a
# machine that has no fleet yet. Print the whole leading comment, not a
# fixed line range - that silently drops the last options as soon as
# anyone adds one.
if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then
  awk 'NR > 1 { if (/^#/) { sub(/^# ?/, ""); print } else { exit } }' "$0"
  exit 0
fi

if [ -n "$shell_fleet" ] && [ "$shell_fleet" != "$FLEET" ]; then
  printf '%s%s%s\n' "$c_dim" \
    "fleet: your exported VM_AGENT_FLEET is stale - using .secrets/fleet.env" "$c_off" >&2
fi

[ -n "$FLEET" ] || die "no roster - set VM_AGENT_FLEET or run ./provision.sh --all"
[ -n "$TOKEN" ] || die "no token - set VM_AGENT_FLEET_TOKEN or run ./provision.sh --all"

vm_names() { printf '%s' "$FLEET" | tr ',' '\n' | cut -d= -f1; }
vm_url()   { printf '%s' "$FLEET" | tr ',' '\n' | awk -F= -v n="$1" '$1==n{print $2; exit}'; }

# $1 method, $2 vm, $3 path, $4 optional json body
call() {
  local method="$1" vm="$2" path="$3" body="${4:-}" url
  url="$(vm_url "$vm")"
  [ -n "$url" ] || die "unknown VM: $vm (known: $(vm_names | tr '\n' ' '))"
  if [ -n "$body" ]; then
    curl -sS --max-time 60 -X "$method" "$url$path" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Content-Type: application/json" -d "$body"
  else
    curl -sS --max-time 30 -X "$method" "$url$path" \
      -H "Authorization: Bearer $TOKEN"
  fi
}

# jq 1.6 exits 0 when its input is empty - the filter never runs, so there
# is no failed output to report - which quietly turns every `jq -e` guard
# into "yes" whenever the command feeding it produced nothing at all: a
# curl that could not connect, a clever call that failed. Insist on real
# input before believing the filter.
json_has() {  # $1.. jq args (filter last); JSON on stdin
  local doc; doc="$(cat)"
  [ -n "$doc" ] || return 1
  printf '%s' "$doc" | jq -e "$@" >/dev/null 2>&1
}

split_target() {  # vm/agent -> sets TGT_VM, TGT_AGENT
  case "$1" in
    */*) TGT_VM="${1%%/*}"; TGT_AGENT="${1#*/}" ;;
    *)   die "target must be <vm>/<agent>, got '$1'" ;;
  esac
}

cmd_status() {
  printf '  %-16s %-9s %-7s %-9s %s\n' VM REACHABLE STAGE AGENTS AUTH
  local name out stage agents auth marker
  while read -r name; do
    [ -n "$name" ] || continue
    marker=""; [ "$name" = "$SELF" ] && marker=" *"
    out="$(call GET "$name" /status 2>/dev/null)"
    if ! printf '%s' "$out" | json_has .; then
      printf '  %-16s %s%-9s%s\n' "$name$marker" "$c_err" "no" "$c_off"
      continue
    fi
    stage="$(printf '%s' "$out" | jq -r '.stage // "?"')"
    auth="$(printf '%s' "$out"  | jq -r '.agent_auth.claude // "-"')"
    agents="$(call GET "$name" /agents 2>/dev/null | jq -r '.result.agents | length' 2>/dev/null)"
    printf '  %-16s %s%-9s%s %-7s %-9s %s\n' \
      "$name$marker" "$c_ok" "yes" "$c_off" "$stage" "${agents:-?}" "$auth"
  done < <(vm_names)
  printf '%s' "$c_dim"; printf '  * = this VM\n'; printf '%s' "$c_off"
}

cmd_agents() {
  local name out
  while read -r name; do
    [ -n "$name" ] || continue
    printf '\n\033[1m%s\033[0m\n' "$name"
    out="$(call GET "$name" /agents 2>/dev/null)"
    printf '%s' "$out" | json_has '.result.agents' || {
      printf '  %sunreachable%s\n' "$c_err" "$c_off"; continue; }
    if [ "$(printf '%s' "$out" | jq -r '.result.agents | length')" = "0" ]; then
      printf '  %sno agents%s\n' "$c_dim" "$c_off"
    else
      printf '%s' "$out" | jq -r '.result.agents[] |
        "  \(.name // .id)  \(.state // .status // "?")  \(.kind // "")"'
    fi
  done < <(vm_names)
}

case "${1:-status}" in
  status) cmd_status ;;
  agents) cmd_agents ;;
  start)
    vm="${2:?usage: fleet start <vm> <name> [kind] [cwd]}"
    name="${3:?usage: fleet start <vm> <name> [kind] [cwd]}"
    body="$(jq -nc --arg n "$name" --arg k "${4:-claude}" \
      --arg c "${5:-}" '{name:$n, kind:$k} + (if $c == "" then {} else {cwd:$c} end)')"
    call POST "$vm" /agents "$body" \
      | jq '{started, pane, status: .agent.agent_status, ready: .agent.interactive_ready, hint}' ;;
  read)
    split_target "${2:?usage: fleet read <vm>/<agent> [-f]}"
    follow=false; source=recent
    for a in "${@:3}"; do
      case "$a" in
        -f|--follow) follow=true ;;
        visible|recent|recent-unwrapped|detection) source="$a" ;;
      esac
    done
    fetch_read() {
      call GET "$TGT_VM" "/agents/$TGT_AGENT/read?source=$source" \
        | jq -r '.result.output // .output // .'
    }
    if ! $follow; then fetch_read; exit 0; fi
    # A terminal read is a screen snapshot, not an append-only log, so this
    # re-renders rather than tailing - closer to `watch` than `tail -f`.
    trap 'printf "\033[?25h\n"; exit 0' INT TERM
    printf '\033[?25l'
    while true; do
      out="$(fetch_read)"
      st="$(call GET "$TGT_VM" "/agents/$TGT_AGENT" | jq -r '.result.agent.agent_status // "?"')"
      printf '\033[H\033[2J'
      printf '%s%s/%s  [%s]  refreshing every %ss - ctrl+c to stop%s\n\n' \
        "$c_dim" "$TGT_VM" "$TGT_AGENT" "$st" "${FLEET_FOLLOW_INTERVAL:-5}" "$c_off"
      printf '%s\n' "$out" | tail -n $(( ${LINES:-40} - 4 ))
      sleep "${FLEET_FOLLOW_INTERVAL:-5}"
    done ;;
  attach)
    # herdr has no federation (`--remote` accepts one target only), so the
    # agent's terminal has to be attached on the VM that owns it. tmux runs
    # on its own socket with prefix ctrl+a, leaving ctrl+b for herdr.
    # <vm> alone attaches the whole remote session; <vm>/<agent> focuses
    # that agent's pane first. Either way you get herdr's full UI, not a
    # bare terminal - `herdr agent attach` hands over one terminal with no
    # multiplexer around it, which is rarely what you want.
    case "${2:?usage: fleet attach <vm>[/<agent>]}" in
      */*) split_target "$2" ;;
      *)   TGT_VM="$2"; TGT_AGENT="" ;;
    esac
    command -v tmux >/dev/null || die "tmux is required for attach"
    command -v clever >/dev/null || die "clever is required for attach"
    sock="fleet-attach"; sess="$TGT_VM${TGT_AGENT:+-$TGT_AGENT}"
    tmux -L "$sock" kill-session -t "$sess" 2>/dev/null
    tmux -L "$sock" new-session -d -s "$sess" "clever ssh --alias '$TGT_VM'"
    tmux -L "$sock" set-option -g prefix C-a
    tmux -L "$sock" unbind-key C-b
    tmux -L "$sock" bind-key C-a send-prefix
    printf '%s\n' "$c_dim  connecting to $TGT_VM…$c_off"
    for _ in $(seq 1 40); do
      tmux -L "$sock" capture-pane -p -t "$sess" 2>/dev/null \
        | grep -qE 'bas@[0-9a-f-]+ +.*\$ *$' && break
      sleep 1
    done
    # Focus the pane first if one was named, then open the full herdr UI.
    if [ -n "$TGT_AGENT" ]; then
      tmux -L "$sock" send-keys -t "$sess" \
        "herdr agent focus $TGT_AGENT >/dev/null 2>&1; herdr" Enter
    else
      tmux -L "$sock" send-keys -t "$sess" "herdr" Enter
    fi
    printf '%s\n' "$c_dim  tmux prefix is ctrl+a (ctrl+b goes to herdr); ctrl+a d to detach$c_off"
    sleep 1
    exec tmux -L "$sock" attach-session -t "$sess" ;;
  prompt)
    split_target "${2:?usage: fleet prompt <vm>/<agent> \"text\"}"
    [ $# -ge 3 ] || die 'usage: fleet prompt <vm>/<agent> "text"'
    call POST "$TGT_VM" "/agents/$TGT_AGENT/prompt" \
      "$(jq -nc --arg t "$3" '{text:$t}')" | jq . ;;
  keys)
    split_target "${2:?usage: fleet keys <vm>/<agent> <key>...}"
    shift 2
    [ $# -ge 1 ] || die "usage: fleet keys <vm>/<agent> <key>..."
    call POST "$TGT_VM" "/agents/$TGT_AGENT/keys" \
      "$(printf '%s\n' "$@" | jq -Rsc 'split("\n") | map(select(length>0)) | {keys:.}')" | jq . ;;
  task)
    split_target "${2:?usage: fleet task <vm>/<agent> \"text\"}"
    [ $# -ge 3 ] || die 'usage: fleet task <vm>/<agent> "text"'
    # Agent UIs collapse tool output, so the terminal is not a reliable
    # transport for results. Ask for the answer as a file instead.
    out="$TGT_AGENT.md"
    full="$3

When you are finished, write your complete answer to ~/out/$out (create the
directory if needed). That file is how it gets collected - the terminal is
not read. Then print one line: WROTE ~/out/$out"
    call POST "$TGT_VM" "/agents/$TGT_AGENT/prompt" \
      "$(jq -nc --arg t "$full" '{text:$t}')" \
      | jq -r '"submitted; collect with: fleet fetch '"$TGT_VM/$TGT_AGENT"'"' ;;
  fetch)
    split_target "${2:?usage: fleet fetch <vm>/<agent> [file]}"
    call GET "$TGT_VM" "/out/${3:-$TGT_AGENT.md}" ;;
  out)
    call GET "${2:?usage: fleet out <vm>}" /out | jq -r '.files[]? | "\(.bytes)\t\(.name)"' ;;
  get)
    call GET "${2:?usage: fleet get <vm> <path>}" "${3:?usage: fleet get <vm> <path>}" ;;
  ls)  vm_names ;;
  *)   die "unknown command: $1 (try --help)" ;;
esac
